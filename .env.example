# Copy to .env.development or .env.production and edit values

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Local MongoDB:
# MONGO_URL=mongodb://127.0.0.1:27017/dance
# Atlas:
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dance?retryWrites=true&w=majority
# Built-in memory DB for quick local testing (no install):
MONGO_URL=memory
