# Copy to .env.development or .env.production and edit values

NODE_ENV=development
PORT=7000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:7000

# Production live:
# FRONTEND_URL=https://dod.senatespace.in
# BACKEND_URL=https://backdod.senatespace.in
# Production Render:
# BACKEND_URL=https://dance-backend-3kwj.onrender.com
# RENDER_BACKEND_URL=https://dance-backend-3kwj.onrender.com
# Extra site origins allowed to call the API (comma-separated):
# CORS_ORIGINS=https://dod.senatespace.in,https://dance-site.netlify.app

# Local MongoDB:
# MONGO_URL=mongodb://127.0.0.1:27017/dance
# Atlas:
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dance?retryWrites=true&w=majority
# Built-in memory DB for quick local testing (no install):
MONGO_URL=memory
